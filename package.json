{
  "name": "imgsorter-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint app server scripts",
    "lint:fix": "oxlint --fix app server scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm generate-routes && pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "seed": "tsx scripts/seed.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.57.0",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-cli": "latest",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
